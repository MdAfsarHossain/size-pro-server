generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
  AVAILABLE
  UNAVAILABLE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserAccessType {
  TOP
  BOTTOM
  FULL_BODY
  HEAD
  SHOES
}

model User {
  id                     String  @id @default(auto()) @map("_id") @db.ObjectId
  firstName              String
  lastName               String
  email                  String  @unique
  password               String?
  image                  String?
  location               String?
  phone                  String?
  totalCreatedProducts   Int     @default(0)
  totalGeneratedProducts Int     @default(0)
  totalSavedTimes        Int     @default(0)
  fcmToken               String?
  role                   Role    @default(ADMIN)

  status    UserStatus @default(ACTIVE)
  lastLogin DateTime?

  gender                Gender?        @default(MALE)
  is_dimensions         Boolean        @default(false)
  is_ai_virtual         Boolean        @default(false)
  is_mannequin          Boolean        @default(false)
  is_background_removal Boolean        @default(false)
  is_model              Boolean        @default(false)
  is_image_diagram      Boolean        @default(false)
  type                  UserAccessType @default(FULL_BODY)
  is_full_access        Boolean        @default(false)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  documents       Document[]
  generatedImages GeneratedImage[]
  savedFiles      SavedFile[]

  @@map("users")
}

model OTP {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @db.ObjectId
  otpCode String

  expiry     DateTime
  created_at DateTime @default(now())

  @@unique([userId, otpCode])
  @@map("otp")
}

model SocialMedia {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  fbLink      String?
  instaLink   String?
  twitterLink String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("socialMedia")
}

model Document {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // title       String?
  // productType ProductType? @default(CLOTH)
  // model       ModelType[]  @default([DIMENSIONS])
  // mannequin   String

  // AI Generated
  aiGenerated       Json
  isDeleted         Boolean @default(false)
  isShopifyUploaded Boolean @default(false)
  mode              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("document")
}

model SavedFile {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  fileUrl   String
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("savedFile")
}

model GeneratedImage {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageDetails      Json
  isDeleted         Boolean @default(false)
  isShopifyUploaded Boolean @default(false)
  mode              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("generatedImage")
}

type ProductDimensions {
  chest_width_cm          Float?
  waist_width_cm          Float?
  back_length_cm          Float?
  sleeve_length_cm        Float?
  has_sleeves             Boolean?
  under_bust_cm           Float?
  dress_length_cm         Float?
  hip_width_cm            Float?
  collar_circumference_cm Float?
  shoe_size_cm            Float?
  available_sizes         String[]
  size_guide              String?
}

type ProductListing {
  title       String?
  description String?
  tags        String[]
  fabric      String?
}

type ProductDetailsInfo {
  category      String?
  brand         String?
  sleeve_length String?
  dress_type    String?
  age_group     String?
  gender        String?
}

type ProductVariantData {
  sizes     String[]
  colors    String[]
  condition String?
  feature   String?
}

type ImagesBatchItem {
  image_index            Int
  selected_features      String[]
  clothing_tag_urls      String[]
  generated_skus         Json
  background_removed_url String?
  backpart_image         String?
  care_instructions      String?
  description            String?
  dimensions             ProductDimensions?
  fabric                 String?
  key_features           String[]
  listing                ProductListing?
  model_urls             String[]
  product_code           String?
  product_details        ProductDetailsInfo?
  product_title          String?
  seo_tags               String[]
  status                 String?
  tags                   String[]
  updated_at             String?
  variant_data           ProductVariantData?
  virtual_tryon_urls     String[]
}

// Typed reference model mirroring the AI_API generation response
// (Document.aiGenerated / GeneratedImage.imageDetails currently store this
// same data as loose Json). Additive only — does not replace those fields.
model AiGeneratedProduct {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId    String @db.ObjectId
  productId String @db.ObjectId

  document         Json
  generatedImageId String[] @db.ObjectId
  mode             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId])
  @@index([userId, productId])
  @@map("aiGeneratedProduct")
}

model ShopifyUploadHistory {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId           String? @db.ObjectId
  generatedImageId String? @db.ObjectId

  handle           String
  title            String
  success          Boolean
  shopifyProductId String?
  adminUrl         String?
  errorMessage     String?

  result Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shopifyUploadHistory")
}

enum ProductType {
  CLOTH
  DRESS
}

enum ModelType {
  DIMENSIONS
  AI_VIRTUAL
  MANNEQUIN
  BACKGROUND_REMOVAL
  MODEL
  IMAGE_DIAGRAM
}

model Feature {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  size             String[]
  categoryEnglish  String[]
  categoryPolish   String[]
  vendorsEnglish   String[]
  vendorPolish     String[]
  fabricEnglish    String[]
  fabricPolish     String[]
  genderEnglish    String[]
  genderPolish     String[]
  colorsEnglish    String[]
  colorsPolish     String[]
  conditionEnglish String[]
  conditionPolish  String[]
  featureEnglish   String[]
  featurePolish    String[]
  tagEnglish       String[]
  tagPolish        String[]
  isPublished      Boolean  @default(false)
  status           String
  customFields     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feature")
}

model ProductVendor {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  brands_name String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product-vendor")
}

model TimeZone {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  timezone  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  timezone  String   @default("Europe/Warsaw")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModelPosition {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  position String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("model-position")
}

enum ProductStatusEnum {
  PENDING
  COMPLETED
  DELETED
  PARTIAL_COMPLETED
}

model ProductStatus {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  status          ProductStatusEnum @default(PENDING)
  userId          String            @db.ObjectId
  productId       String
  product         Int               @default(0)
  generatedImages Int               @default(0)
  totalSavedTimes Int               @default(0)
  customFields    Json
  mode            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product-status")
}

